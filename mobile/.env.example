# Copy this file to ".env" (same folder) and fill in the two values from
# Supabase → Project Settings → API Keys.
# Use the PUBLISHABLE key (starts with sb_publishable_). Never the secret one.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_REPLACE_ME

# Stripe → Developers → API keys → Publishable key (pk_test_… while testing).
# Leave empty and the app runs without payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Virtual try-on without Supabase (local testing only): run
# `DECART_API_KEY=... node scripts/tryon-token-dev.mjs` and set this.
# With Supabase, deploy the tryon-token function and leave this empty.
EXPO_PUBLIC_TRYON_TOKEN_URL=
