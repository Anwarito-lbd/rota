{
  "expo": {
    "name": "Rota",
    "slug": "rota",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rota",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rota.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Pour filmer une pi\u00e8ce \u00e0 louer ou photographier le retour.",
        "NSPhotoLibraryUsageDescription": "Pour choisir des photos de votre closet.",
        "NSLocationWhenInUseUsageDescription": "Pour montrer les pi\u00e8ces pr\u00e8s de vous \u00e0 Paris."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A0B"
      },
      "package": "com.rota.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C0A0B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
