{
  "expo": {
    "name": "Rota",
    "slug": "rota",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rota",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rota.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Pour filmer une pièce à louer ou photographier le retour.",
        "NSPhotoLibraryUsageDescription": "Pour choisir des photos de votre closet.",
        "NSLocationWhenInUseUsageDescription": "Pour montrer les pièces près de vous à Paris."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0A0B"
      },
      "package": "com.rota.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
