{
  "name": "rota",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=packages/shared",
    "mobile": "npm run start --workspace=apps/mobile",
    "api": "npm run dev --workspace=apps/api",
    "seed": "npm run build --workspace=packages/shared && npm run seed --workspace=apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:shared": "npm run build --workspace=packages/shared"
  },
  "engines": {
    "node": ">=20"
  }
}
